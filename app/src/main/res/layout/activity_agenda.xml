<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── TOPBAR ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/blue_pale"
                    android:layout_marginEnd="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="←"
                        android:textSize="20sp"
                        android:textColor="@color/accent_blue"
                        android:fontFamily="@font/outfit_bold"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agenda"
                        android:textSize="17sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/outfit_bold"/>
                    <TextView
                        android:id="@+id/tvAgendaSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hoy"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:fontFamily="@font/outfit_regular"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>

                <!-- Filtro servicio -->

                <!-- Añadir cita -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnAddCita"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/accent_blue">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="＋"
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/outfit_bold"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── TABS VISTA ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/blue_pale2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp"
                android:weightSum="3">

                <TextView
                    android:id="@+id/tabDiaria"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Diaria"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_bold"
                    android:gravity="center"
                    android:background="@drawable/shape_tab_active"
                    android:textColor="@color/white"/>

                <TextView
                    android:id="@+id/tabSemanal"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Semanal"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_bold"
                    android:gravity="center"
                    android:background="@drawable/shape_tab_inactive"
                    android:textColor="@color/text_muted"/>

                <TextView
                    android:id="@+id/tabMensual"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Mensual"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_bold"
                    android:gravity="center"
                    android:background="@drawable/shape_tab_inactive"
                    android:textColor="@color/text_muted"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── CONTENIDO (se reemplaza desde Java) ── -->
        <FrameLayout
            android:id="@+id/contenedorVista"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="60dp"/>

    </LinearLayout>

    <!-- BOTTOM NAV FLOTANTE -->
    <!--
        CORRECCIÓN: CardView → FrameLayout con bg_nav_card.xml:
          <shape>
            <solid android:color="#FFFFFF"/>
            <corners android:radius="30dp"/>
          </shape>
        elevation + outlineProvider + clipToOutline evitan el fondo blanco
        que se filtraba fuera de los bordes redondeados.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_nav_card"
        android:clipToOutline="true"
        android:elevation="24dp"
        android:outlineProvider="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/nav_item_normal"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:elevation="2dp"
                    android:src="@drawable/ic_home"
                    android:tint="#9CA3AF" />

                <TextView
                    android:id="@+id/navLabelHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/outfit_bold"
                    android:gravity="center"
                    android:text="Inicio"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_clientes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/nav_item_normal"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_people"
                    android:tint="#9CA3AF" />

                <TextView
                    android:id="@+id/navLabelClientes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/outfit_regular"
                    android:gravity="center"
                    android:text="Clientes"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_gimnasio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/nav_item_normal"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navIconGimnasio"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_fitness"
                    android:tint="#9CA3AF" />

                <TextView
                    android:id="@+id/navLabelGimnasio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/outfit_regular"
                    android:gravity="center"
                    android:text="Gym"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_agenda"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/nav_item_selected"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_calendar_today"
                    android:tint="#0A66FF" />

                <TextView
                    android:id="@+id/navLabelAgenda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/outfit_regular"
                    android:gravity="center"
                    android:text="Agenda"
                    android:textColor="#0A66FF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_cobros"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/nav_item_normal"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_payments"
                    android:tint="#9CA3AF" />

                <TextView
                    android:id="@+id/navLabelCobros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/outfit_regular"
                    android:gravity="center"
                    android:text="Cobros"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>



</androidx.coordinatorlayout.widget.CoordinatorLayout>