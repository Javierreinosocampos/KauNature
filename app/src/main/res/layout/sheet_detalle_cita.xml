<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_sheet_bg">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/shape_handle"/>

    <!-- Cabecera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <androidx.cardview.widget.CardView
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="17dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/accent_blue"
            android:layout_marginEnd="14dp">
            <TextView
                android:id="@+id/tvCitaInicial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="L"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:fontFamily="@font/outfit_bold"
                android:gravity="center"/>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvCitaCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lucía Martín"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/outfit_bold"/>
            <TextView
                android:id="@+id/tvCitaServicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Masaje Relajante · 50 min"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/outfit_regular"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvCitaEstadoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pendiente"
            android:textSize="10sp"
            android:textColor="@color/white"
            android:fontFamily="@font/outfit_bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/shape_chip_blue"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>

    <!-- Info cita -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvCitaFechaHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 Lunes 07/03/2026 · 10:00h"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/outfit_regular"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvCitaPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰 35€"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/outfit_regular"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvCitaNotas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝 Sin notas"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/outfit_regular"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="14dp"/>

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/btnCitaConfirmar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/accent_blue">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="✅ Confirmar"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:fontFamily="@font/outfit_bold"
                android:gravity="center"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnCitaEditar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/blue_pale">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="✏️ Editar"
                android:textSize="13sp"
                android:textColor="@color/accent_blue"
                android:fontFamily="@font/outfit_bold"
                android:gravity="center"/>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/btnCitaCobrar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/blue_pale">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="💰 Cobrar"
                android:textSize="13sp"
                android:textColor="@color/accent_blue"
                android:fontFamily="@font/outfit_bold"
                android:gravity="center"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnCitaCancelar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFF0F0">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="❌ Cancelar"
                android:textSize="13sp"
                android:textColor="#EF4444"
                android:fontFamily="@font/outfit_bold"
                android:gravity="center"/>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="16dp"/>

</LinearLayout>