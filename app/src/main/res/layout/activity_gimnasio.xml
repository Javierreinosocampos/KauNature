<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_gimnasio.xml
    ─────────────────────
    Contiene SOLO los elementos estáticos de GimnasioActivity:
      • Header (fondo degradado, botón back, título, subtítulo, botón fitness)
      • Tabs vista (Día / Semana / Mes)
      • Selector de días (HorizontalScrollView vacío, relleno en Java)
      • KPI strip
      • Separador
      • Contenedor dinámico (llContenido) → relleno íntegramente en Java
      • FAB añadir
      • NavBar flotante

    Las tarjetas de franjas, vistas semana/mes y bottom-sheets
    se siguen construyendo en GimnasioUI.java porque son dinámicas.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gimnasio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FF">

    <!-- ════════════════════════════════════════════════════════
         SCROLL PRINCIPAL
         ════════════════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/svGimnasio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ════════════════════════════════════════════════
                 HEADER
                 ════════════════════════════════════════════════ -->
            <FrameLayout
                android:id="@+id/gimnasio_header"
                android:layout_width="match_parent"
                android:layout_height="172dp"
                android:background="@drawable/bg_header_spectacular"
                android:elevation="12dp">

                <!-- Círculo decorativo superior-derecho -->
                <View
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/shape_actions_circle_top"
                    android:translationX="50dp"
                    android:translationY="-50dp" />

                <!-- Círculo decorativo inferior-izquierdo -->
                <View
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="bottom|start"
                    android:background="@drawable/shape_actions_circle_bottom"
                    android:translationX="-30dp"
                    android:translationY="30dp" />

                <!-- Línea shimmer superior -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="top"
                    android:layout_marginStart="28dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="28dp"
                    android:background="@drawable/shape_shimmer_line" />

                <!-- Contenido del header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="56dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Botón Back -->
                    <FrameLayout
                        android:id="@+id/gimnasio_btn_back"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/shape_inscribir_icon_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/outfit_bold"
                            android:gravity="center"
                            android:text="←"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp" />
                    </FrameLayout>

                    <!-- Columna de título -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_bold"
                            android:letterSpacing="0.24"
                            android:text="KAU NATURE"
                            android:textColor="#93C5FD"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/outfit_bold"
                            android:shadowColor="#60000000"
                            android:shadowDx="0"
                            android:shadowDy="4"
                            android:shadowRadius="14"
                            android:text="Gimnasio"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp" />

                        <TextView
                            android:id="@+id/gimnasio_tv_sub_dia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/outfit_regular"
                            android:text="—"
                            android:textColor="#BFDBFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Botón configurar franjas -->
                    <FrameLayout
                        android:id="@+id/gimnasio_btn_fitness"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_header_btn"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:elevation="10dp"
                        android:focusable="true"
                        android:outlineProvider="background">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_fitness"
                            android:tint="#0A66FF" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Separador fondo -->
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="#F7F9FF" />

            <!-- ════════════════════════════════════════════════
                 TABS VISTA (Día / Semana / Mes)
                 ════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/gimnasio_tabs_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="4dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/gimnasio_tab_dia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/shape_tab_active"
                    android:fontFamily="@font/outfit_bold"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:text="Día"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/gimnasio_tab_semana"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/shape_tab_inactive"
                    android:fontFamily="@font/outfit_regular"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:text="Semana"
                    android:textColor="#4B5563"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/gimnasio_tab_mes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_tab_inactive"
                    android:fontFamily="@font/outfit_regular"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:text="Mes"
                    android:textColor="#4B5563"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ════════════════════════════════════════════════
                 SELECTOR DE DÍAS (HorizontalScrollView)
                 Los pills de días se añaden en Java (son dinámicos)
                 ════════════════════════════════════════════════ -->
            <HorizontalScrollView
                android:id="@+id/gimnasio_hsv_dias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/gimnasio_ll_dias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp" />
            </HorizontalScrollView>

            <!-- ════════════════════════════════════════════════
                 KPI STRIP
                 ════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical">

                <!-- Línea superior -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5EDFF" />

                <!-- Barra de KPIs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <!-- KPI Personas -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/gimnasio_kpi_personas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_bold"
                            android:gravity="center"
                            android:text="—"
                            android:textColor="#2563EB"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_bold"
                            android:gravity="center"
                            android:letterSpacing="0.1"
                            android:text="PERSONAS"
                            android:textColor="#9CA3AF"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <!-- Separador -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_vertical"
                        android:background="#E5EDFF" />

                    <!-- KPI Ocupación -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/gimnasio_kpi_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_bold"
                            android:gravity="center"
                            android:text="—"
                            android:textColor="#F59E0B"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_bold"
                            android:gravity="center"
                            android:letterSpacing="0.1"
                            android:text="OCUPACIÓN"
                            android:textColor="#9CA3AF"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <!-- Separador -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_vertical"
                        android:background="#E5EDFF" />

                    <!-- KPI Libres -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/gimnasio_kpi_libres"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_bold"
                            android:gravity="center"
                            android:text="—"
                            android:textColor="#10B981"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_bold"
                            android:gravity="center"
                            android:letterSpacing="0.1"
                            android:text="LIBRES"
                            android:textColor="#9CA3AF"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <!-- Separador -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_vertical"
                        android:background="#E5EDFF" />

                    <!-- KPI Franjas -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/gimnasio_kpi_slots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_bold"
                            android:gravity="center"
                            android:text="—"
                            android:textColor="#4B5563"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_bold"
                            android:gravity="center"
                            android:letterSpacing="0.1"
                            android:text="FRANJAS"
                            android:textColor="#9CA3AF"
                            android:textSize="8sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Línea inferior -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5EDFF" />
            </LinearLayout>

            <!-- Separador fondo -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#F7F9FF" />

            <!-- ════════════════════════════════════════════════
                 CONTENEDOR DINÁMICO
                 Franjas, semana, mes se añaden en GimnasioUI.java
                 ════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/gimnasio_ll_contenido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="110dp" />

        </LinearLayout>
    </ScrollView>

    <!-- ════════════════════════════════════════════════════════
         FAB AÑADIR
         ════════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/gimnasio_fab"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="92dp"
        android:background="@drawable/shape_gimnasio_fab"
        android:elevation="8dp"
        android:fontFamily="@font/outfit_bold"
        android:gravity="center"
        android:text="＋"
        android:textColor="#FFFFFF"
        android:textSize="26sp" />

    <!-- ════════════════════════════════════════════════════════
         NAV BAR FLOTANTE
         ════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_nav_card"
        android:clipToOutline="true"
        android:elevation="24dp"
        android:outlineProvider="background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <!-- Inicio -->
            <LinearLayout
                android:id="@+id/gimnasio_nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/nav_item_normal"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_home"
                    android:tint="#9CA3AF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/outfit_regular"
                    android:gravity="center"
                    android:text="Inicio"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Clientes -->
            <LinearLayout
                android:id="@+id/gimnasio_nav_clientes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/nav_item_normal"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_people"
                    android:tint="#9CA3AF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/outfit_regular"
                    android:gravity="center"
                    android:text="Clientes"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Gym (seleccionado) -->
            <LinearLayout
                android:id="@+id/gimnasio_nav_gym"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/nav_item_selected"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_fitness"
                    android:tint="#0A66FF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/outfit_bold"
                    android:gravity="center"
                    android:text="Gym"
                    android:textColor="#0A66FF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Agenda -->
            <LinearLayout
                android:id="@+id/gimnasio_nav_agenda"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/nav_item_normal"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_calendar_today"
                    android:tint="#9CA3AF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/outfit_regular"
                    android:gravity="center"
                    android:text="Agenda"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Cobros -->
            <LinearLayout
                android:id="@+id/gimnasio_nav_cobros"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/nav_item_normal"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_payments"
                    android:tint="#9CA3AF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/outfit_regular"
                    android:gravity="center"
                    android:text="Cobros"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</FrameLayout>