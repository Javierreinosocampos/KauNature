<?xml version="1.0" encoding="utf-8"?>
<!-- res/values/themes.xml -->
<resources>

    <style name="Theme.KauNatureApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Superficie y fondo -->
        <item name="android:colorBackground">@color/bg_main</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/blue_pale2</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
        <!-- Barra de estado y navegación — extiende bajo el notch -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Estilo BottomSheet -->
    <style name="KauBottomSheetStyle" parent="Theme.Material3.Light.BottomSheetDialog"/>

    <!-- Indicador píldora azul del BottomNav -->
    <style name="KauNavIndicator">
        <item name="android:color">@color/accent_blue</item>
        <item name="shapeAppearance">@style/KauNavIndicatorShape</item>
    </style>

    <style name="KauNavIndicatorShape" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

</resources>