<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/shape_sheet_bg">

        <View
            android:layout_width="40dp" android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp" android:layout_marginBottom="4dp"
            android:background="@drawable/shape_handle"/>

        <TextView
            android:id="@+id/tvNuevoCobroTitulo"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Registrar cobro"
            android:textSize="18sp" android:textColor="@color/text_primary"
            android:fontFamily="@font/outfit_bold"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="14dp" android:paddingBottom="14dp"/>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/border"
            android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
            android:layout_marginBottom="14dp"/>

        <!-- Cliente -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Cliente *" android:textSize="11sp" android:textColor="@color/text_muted"
            android:fontFamily="@font/outfit_bold" android:paddingStart="20dp" android:paddingBottom="4dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp" app:cardElevation="1dp" app:cardBackgroundColor="@color/white">
            <EditText android:id="@+id/etCobroCliente"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Nombre del cliente" android:textSize="13sp"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"
                android:fontFamily="@font/outfit_regular" android:background="@null"
                android:padding="14dp" android:inputType="textPersonName" android:maxLines="1"/>
        </androidx.cardview.widget.CardView>

        <!-- Concepto -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Concepto" android:textSize="11sp" android:textColor="@color/text_muted"
            android:fontFamily="@font/outfit_bold" android:paddingStart="20dp" android:paddingBottom="4dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp" app:cardElevation="1dp" app:cardBackgroundColor="@color/white">
            <EditText android:id="@+id/etCobroConcepto"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Ej: Masaje Relajante, Membresía…" android:textSize="13sp"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"
                android:fontFamily="@font/outfit_regular" android:background="@null"
                android:padding="14dp" android:inputType="text" android:maxLines="1"/>
        </androidx.cardview.widget.CardView>

        <!-- Importe -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Importe (€) *" android:textSize="11sp" android:textColor="@color/text_muted"
            android:fontFamily="@font/outfit_bold" android:paddingStart="20dp" android:paddingBottom="4dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp" app:cardElevation="1dp" app:cardBackgroundColor="@color/white">
            <EditText android:id="@+id/etCobroImporte"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Ej: 35" android:textSize="13sp"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"
                android:fontFamily="@font/outfit_regular" android:background="@null"
                android:padding="14dp" android:inputType="numberDecimal" android:maxLines="1"/>
        </androidx.cardview.widget.CardView>

        <!-- Método de pago -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Método de pago *" android:textSize="11sp" android:textColor="@color/text_muted"
            android:fontFamily="@font/outfit_bold" android:paddingStart="20dp" android:paddingBottom="8dp"/>

        <LinearLayout android:id="@+id/layoutMetodos"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:weightSum="4"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginBottom="12dp"/>

        <!-- Estado cobro -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Estado" android:textSize="11sp" android:textColor="@color/text_muted"
            android:fontFamily="@font/outfit_bold" android:paddingStart="20dp" android:paddingBottom="8dp"/>

        <LinearLayout android:id="@+id/layoutEstados"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:weightSum="2"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginBottom="20dp"/>

        <!-- Notas -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Notas" android:textSize="11sp" android:textColor="@color/text_muted"
            android:fontFamily="@font/outfit_bold" android:paddingStart="20dp" android:paddingBottom="4dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="20dp"
            app:cardCornerRadius="14dp" app:cardElevation="1dp" app:cardBackgroundColor="@color/white">
            <EditText android:id="@+id/etCobroNotas"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Observaciones…" android:textSize="13sp"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"
                android:fontFamily="@font/outfit_regular" android:background="@null"
                android:padding="14dp" android:inputType="textMultiLine"
                android:minLines="2" android:maxLines="4" android:gravity="top"/>
        </androidx.cardview.widget.CardView>

        <!-- Botón guardar -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnGuardarCobro"
            android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp" app:cardElevation="4dp" app:cardBackgroundColor="@color/accent_blue">
            <TextView
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:text="Guardar cobro"
                android:textSize="14sp" android:textColor="@color/white"
                android:fontFamily="@font/outfit_bold" android:gravity="center"/>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>