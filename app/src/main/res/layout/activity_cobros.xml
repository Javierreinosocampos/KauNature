<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="90dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── TOPBAR ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/blue_pale"
                        android:layout_marginEnd="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="←"
                            android:textSize="20sp"
                            android:textColor="@color/accent_blue"
                            android:fontFamily="@font/outfit_bold"
                            android:gravity="center"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cobros"
                            android:textSize="17sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/outfit_bold"/>
                        <TextView
                            android:id="@+id/tvCobrosSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Este mes"
                            android:textSize="11sp"
                            android:textColor="@color/text_muted"
                            android:fontFamily="@font/outfit_regular"
                            android:layout_marginTop="1dp"/>
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnNuevoCobro"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/accent_blue">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="＋"
                            android:textSize="20sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/outfit_bold"
                            android:gravity="center"/>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── RESUMEN MES ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/accent_blue">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvMesLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Marzo 2026"
                        android:textSize="11sp"
                        android:textColor="#AACCFF"
                        android:fontFamily="@font/outfit_regular"/>

                    <TextView
                        android:id="@+id/tvTotalMes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0,00€"
                        android:textSize="34sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/outfit_bold"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- KPIs fila -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvKpiEfectivo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0€"
                                android:textSize="16sp"
                                android:textColor="@color/white"
                                android:fontFamily="@font/outfit_bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💵 Efectivo"
                                android:textSize="10sp"
                                android:textColor="#AACCFF"
                                android:fontFamily="@font/outfit_regular"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvKpiTarjeta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0€"
                                android:textSize="16sp"
                                android:textColor="@color/white"
                                android:fontFamily="@font/outfit_bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💳 Tarjeta"
                                android:textSize="10sp"
                                android:textColor="#AACCFF"
                                android:fontFamily="@font/outfit_regular"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvKpiBizumTransfer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0€"
                                android:textSize="16sp"
                                android:textColor="@color/white"
                                android:fontFamily="@font/outfit_bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📱 Bizum/Trans."
                                android:textSize="10sp"
                                android:textColor="#AACCFF"
                                android:fontFamily="@font/outfit_regular"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── FILTROS ── -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/filtroTodos"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Todos" android:textSize="12sp" android:fontFamily="@font/outfit_bold"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_filter_active"
                        android:textColor="@color/white"/>

                    <TextView android:id="@+id/filtroPendientes"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Pendientes" android:textSize="12sp" android:fontFamily="@font/outfit_bold"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_filter_inactive"
                        android:textColor="@color/text_muted"/>

                    <TextView android:id="@+id/filtroCobrados"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Cobrados" android:textSize="12sp" android:fontFamily="@font/outfit_bold"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_filter_inactive"
                        android:textColor="@color/text_muted"/>

                    <TextView android:id="@+id/filtroEfectivo"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💵 Efectivo" android:textSize="12sp" android:fontFamily="@font/outfit_bold"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_filter_inactive"
                        android:textColor="@color/text_muted"/>

                    <TextView android:id="@+id/filtroTarjeta"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💳 Tarjeta" android:textSize="12sp" android:fontFamily="@font/outfit_bold"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_filter_inactive"
                        android:textColor="@color/text_muted"/>

                    <TextView android:id="@+id/filtroBizum"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📱 Bizum" android:textSize="12sp" android:fontFamily="@font/outfit_bold"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_filter_inactive"
                        android:textColor="@color/text_muted"/>

                    <TextView android:id="@+id/filtroTransferencia"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🏦 Transferencia" android:textSize="12sp" android:fontFamily="@font/outfit_bold"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:background="@drawable/shape_filter_inactive"
                        android:textColor="@color/text_muted"/>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- ── COBROS PENDIENTES ── -->
            <LinearLayout
                android:id="@+id/seccionPendientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Pendientes de cobro"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/outfit_bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/listaPendientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"/>

            </LinearLayout>

            <!-- ── HISTORIAL ── -->
            <LinearLayout
                android:id="@+id/seccionHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ Historial de cobros"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/outfit_bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/listaHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </LinearLayout>

            <!-- Estado vacío -->
            <LinearLayout
                android:id="@+id/layoutVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="48dp"
                android:paddingBottom="48dp"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="💰" android:textSize="48sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sin cobros" android:textSize="16sp"
                    android:textColor="@color/text_primary" android:fontFamily="@font/outfit_bold"
                    android:gravity="center" android:layout_marginTop="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Pulsa ＋ para registrar un cobro"
                    android:textSize="12sp" android:textColor="@color/text_muted"
                    android:fontFamily="@font/outfit_regular"
                    android:gravity="center" android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── BOTTOM NAV (Inicio · Clientes · [COBROS] · Agenda · Ajustes) ── -->
    <!-- ══ BOTTOM NAV: Inicio · Clientes · [💪Gimnasio] · Agenda · Cobros ══ -->
    <LinearLayout
        android:id="@+id/bottomNavCustom"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:elevation="20dp"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <!-- INICIO -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp">
            <TextView
                android:id="@+id/navIconHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="17sp"
                android:gravity="center"/>
            <TextView
                android:id="@+id/navLabelHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textSize="9sp"
                android:textColor="@color/text_muted"
                android:gravity="center"/>
        </LinearLayout>

        <!-- CLIENTES -->
        <LinearLayout
            android:id="@+id/nav_clientes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp">
            <TextView
                android:id="@+id/navIconClientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥"
                android:textSize="17sp"
                android:gravity="center"/>
            <TextView
                android:id="@+id/navLabelClientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clientes"
                android:textSize="9sp"
                android:textColor="@color/text_muted"
                android:gravity="center"/>
        </LinearLayout>
        <!-- GIMNASIO -->
        <LinearLayout
            android:id="@+id/nav_gimnasio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp">
            <TextView
                android:id="@+id/navIconGimnasio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💪"
                android:textSize="17sp"
                android:gravity="center"/>
            <TextView
                android:id="@+id/navLabelGimnasio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gimnasio"
                android:textSize="9sp"
                android:textColor="@color/accent_blue"
                android:gravity="center"/>
        </LinearLayout>

        <!-- AGENDA -->
        <LinearLayout
            android:id="@+id/nav_agenda"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp">
            <TextView
                android:id="@+id/navIconAgenda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅"
                android:textSize="17sp"
                android:gravity="center"/>
            <TextView
                android:id="@+id/navLabelAgenda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agenda"
                android:textSize="9sp"
                android:textColor="@color/text_muted"
                android:gravity="center"/>
        </LinearLayout>

        <!-- COBROS -->
        <LinearLayout
            android:id="@+id/nav_cobros"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp">
            <TextView
                android:id="@+id/navIconCobros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰"
                android:textSize="17sp"
                android:gravity="center"/>
            <TextView
                android:id="@+id/navLabelCobros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cobros"
                android:textSize="9sp"
                android:textColor="@color/text_muted"
                android:gravity="center"/>
        </LinearLayout>

    </LinearLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>