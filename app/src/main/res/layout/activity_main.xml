<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FF">

    <!-- ══ CONTENIDO PRINCIPAL ══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── HEADER ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="52dp"
                android:paddingBottom="18dp">

                <!-- Fila título + botones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KAU NATURE"
                            android:textSize="9sp"
                            android:textColor="#2563EB"
                            android:letterSpacing="0.18"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Buenos días"
                            android:textSize="28sp"
                            android:textColor="#0D1B3E"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvFechaHoy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hoy"
                            android:textSize="12sp"
                            android:textColor="#9CA3AF"/>

                    </LinearLayout>

                    <!-- Notificaciones -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnNotif"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#EEF4FF">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="🔔"
                                android:textSize="18sp"
                                android:gravity="center"/>

                            <View
                                android:id="@+id/badgeNotif"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_gravity="top|end"
                                android:layout_margin="6dp"
                                android:background="#EF4444"
                                android:visibility="gone"/>

                        </FrameLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Settings -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnSettings"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#EEF4FF">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="⚙"
                            android:textSize="18sp"
                            android:gravity="center"/>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </LinearLayout>

            <!-- ── CUERPO ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ── ACCIONES RÁPIDAS ── -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#2563EB">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Acciones rápidas"
                                    android:textSize="16sp"
                                    android:textColor="#FFFFFF"
                                    android:textStyle="bold"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="¿Qué hacemos hoy?"
                                    android:textSize="11sp"
                                    android:textColor="#BFDBFF"
                                    android:layout_marginTop="2dp"/>

                            </LinearLayout>

                            <androidx.cardview.widget.CardView
                                android:id="@+id/fabQuick"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#33FFFFFF">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:text="＋"
                                    android:textSize="22sp"
                                    android:textColor="#FFFFFF"
                                    android:textStyle="bold"
                                    android:gravity="center"/>

                            </androidx.cardview.widget.CardView>

                        </LinearLayout>

                        <!-- Botones acciones 2x2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnAccionCobrar"
                                android:layout_width="0dp"
                                android:layout_height="70dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#1D4ED8">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingStart="14dp"
                                    android:paddingEnd="10dp">

                                    <TextView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:text="💰"
                                        android:textSize="17sp"
                                        android:gravity="center"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Cobrar"
                                        android:textSize="13sp"
                                        android:textColor="#FFFFFF"
                                        android:textStyle="bold"
                                        android:layout_marginStart="6dp"/>

                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnAccionCita"
                                android:layout_width="0dp"
                                android:layout_height="70dp"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#1D4ED8">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingStart="14dp"
                                    android:paddingEnd="10dp">

                                    <TextView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:text="📅"
                                        android:textSize="17sp"
                                        android:gravity="center"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Nueva cita"
                                        android:textSize="13sp"
                                        android:textColor="#FFFFFF"
                                        android:textStyle="bold"
                                        android:layout_marginStart="6dp"/>

                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnAccionGym"
                                android:layout_width="0dp"
                                android:layout_height="70dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#1D4ED8">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingStart="14dp"
                                    android:paddingEnd="10dp">

                                    <TextView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:text="💪"
                                        android:textSize="17sp"
                                        android:gravity="center"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Gimnasio"
                                        android:textSize="13sp"
                                        android:textColor="#FFFFFF"
                                        android:textStyle="bold"
                                        android:layout_marginStart="6dp"/>

                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnAccionClientes"
                                android:layout_width="0dp"
                                android:layout_height="70dp"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#1D4ED8">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingStart="14dp"
                                    android:paddingEnd="10dp">

                                    <TextView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:text="👥"
                                        android:textSize="17sp"
                                        android:gravity="center"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Clientes"
                                        android:textSize="13sp"
                                        android:textColor="#FFFFFF"
                                        android:textStyle="bold"
                                        android:layout_marginStart="6dp"/>

                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ── KPIs ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Citas -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#FFFFFF">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:id="@+id/tvKpiCitas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3"
                                android:textSize="32sp"
                                android:textColor="#2563EB"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Citas hoy"
                                android:textSize="10sp"
                                android:textColor="#9CA3AF"
                                android:textStyle="bold"
                                android:letterSpacing="0.05"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Gym -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#FFFFFF">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:id="@+id/tvKpiGym"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="32sp"
                                android:textColor="#10B981"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="En gym hoy"
                                android:textSize="10sp"
                                android:textColor="#9CA3AF"
                                android:textStyle="bold"
                                android:letterSpacing="0.05"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Ingresos -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#FFFFFF">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:id="@+id/tvKpiIngresos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="32sp"
                                android:textColor="#F59E0B"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ingresos hoy"
                                android:textSize="10sp"
                                android:textColor="#9CA3AF"
                                android:textStyle="bold"
                                android:letterSpacing="0.05"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- ── CITAS HOY ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Citas de hoy"
                        android:textSize="14sp"
                        android:textColor="#0D1B3E"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvVerCitas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver agenda →"
                        android:textSize="11sp"
                        android:textColor="#2563EB"
                        android:textStyle="bold"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/listaCitas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"/>

                <!-- ── PAGOS PENDIENTES ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pagos pendientes"
                        android:textSize="14sp"
                        android:textColor="#0D1B3E"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvVerPagos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver cobros →"
                        android:textSize="11sp"
                        android:textColor="#2563EB"
                        android:textStyle="bold"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/listaPagos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══ BOTTOM NAV ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <LinearLayout android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠" android:textSize="17sp" android:gravity="center"/>
            <TextView android:id="@+id/navLabelHome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inicio" android:textSize="9sp" android:textColor="#6B7FA3" android:gravity="center"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_clientes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👥" android:textSize="17sp" android:gravity="center"/>
            <TextView android:id="@+id/navLabelClientes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clientes" android:textSize="9sp" android:textColor="#6B7FA3" android:gravity="center"/>
        </LinearLayout>

        <!-- GIMNASIO -->
        <LinearLayout android:id="@+id/nav_gimnasio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingVertical="4dp">
            <TextView android:id="@+id/navIconGimnasio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💪" android:textSize="17sp" android:gravity="center"/>
            <TextView android:id="@+id/navLabelGimnasio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gimnasio" android:textSize="9sp" android:textColor="#2563EB" android:gravity="center"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_agenda" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📅" android:textSize="17sp" android:gravity="center"/>
            <TextView android:id="@+id/navLabelAgenda" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Agenda" android:textSize="9sp" android:textColor="#6B7FA3" android:gravity="center"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_cobros" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💰" android:textSize="17sp" android:gravity="center"/>
            <TextView android:id="@+id/navLabelCobros" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cobros" android:textSize="9sp" android:textColor="#6B7FA3" android:gravity="center"/>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>