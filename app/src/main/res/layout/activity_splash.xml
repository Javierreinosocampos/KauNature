<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg">

    <View
        android:id="@+id/circleTopLeft"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="@drawable/shape_circle_glow_blue"
        android:alpha="0.18"
        android:translationX="-100dp"
        android:translationY="-100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/circleBottomRight"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/shape_circle_glow_blue"
        android:alpha="0.13"
        android:translationX="60dp"
        android:translationY="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/centerBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/logoCard"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            app:cardCornerRadius="40dp"
            app:cardBackgroundColor="#00000000"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/logo_kau_auntentico"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Logo Kau Nature" />

        </androidx.cardview.widget.CardView>

        <View android:layout_width="1dp" android:layout_height="28dp" />

        <TextView
            android:id="@+id/tvBrandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kau Nature"
            android:textSize="32sp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/outfit_bold"
            android:letterSpacing="0.04"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="27dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/outfit_regular"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="Francisco Javier Cuevas López"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/Widget.AppCompat.ProgressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="@color/accent_blue"
            android:layout_gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cargando..."
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/outfit_regular"
            android:letterSpacing="0.08" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>