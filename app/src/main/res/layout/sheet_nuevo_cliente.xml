<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/shape_sheet_bg">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/shape_handle"/>

    <!-- Header -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/gradient_blue_primary"
            android:padding="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_people"
                android:tint="#FFFFFF"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuevo cliente"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:fontFamily="@font/outfit_bold"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Botón Guardar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnGuardarCliente"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#0A66FF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_check_circle"
                android:tint="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvGuardarCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardar cliente"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:fontFamily="@font/outfit_bold"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Contenido scrollable -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Nombre -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nombre *"
                        android:textSize="11sp"
                        android:textColor="#0A66FF"
                        android:fontFamily="@font/outfit_bold"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etNuevoNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ej: Lucía"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="#9CA3AF"
                        android:fontFamily="@font/outfit_regular"
                        android:background="@null"
                        android:inputType="textCapWords"
                        android:maxLines="1"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Apellidos -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apellidos"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:fontFamily="@font/outfit_bold"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etNuevoApellidos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ej: Martín"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="#9CA3AF"
                        android:fontFamily="@font/outfit_regular"
                        android:background="@null"
                        android:inputType="textCapWords"
                        android:maxLines="1"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Teléfono -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_phone"
                            android:tint="@color/text_muted"
                            android:layout_marginEnd="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Teléfono"
                            android:textSize="11sp"
                            android:textColor="@color/text_muted"
                            android:fontFamily="@font/outfit_bold"/>

                    </LinearLayout>

                    <EditText
                        android:id="@+id/etNuevoTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="600 000 000"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="#9CA3AF"
                        android:fontFamily="@font/outfit_regular"
                        android:background="@null"
                        android:inputType="phone"
                        android:maxLines="1"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Email -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_email"
                            android:tint="@color/text_muted"
                            android:layout_marginEnd="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email"
                            android:textSize="11sp"
                            android:textColor="@color/text_muted"
                            android:fontFamily="@font/outfit_bold"/>

                    </LinearLayout>

                    <EditText
                        android:id="@+id/etNuevoEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="correo@ejemplo.com"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="#9CA3AF"
                        android:fontFamily="@font/outfit_regular"
                        android:background="@null"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Día de inicio de membresía -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Día de inicio (1-31)"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:fontFamily="@font/outfit_bold"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etNuevoDiaInicio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ej: 15"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="#9CA3AF"
                        android:fontFamily="@font/outfit_regular"
                        android:background="@null"
                        android:inputType="number"
                        android:maxLines="1"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Notas -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_notes"
                            android:tint="@color/text_muted"
                            android:layout_marginEnd="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notas"
                            android:textSize="11sp"
                            android:textColor="@color/text_muted"
                            android:fontFamily="@font/outfit_bold"/>

                    </LinearLayout>

                    <EditText
                        android:id="@+id/etNuevoNotas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Alergias, preferencias…"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="#9CA3AF"
                        android:fontFamily="@font/outfit_regular"
                        android:background="@null"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="2"
                        android:maxLines="2"
                        android:gravity="top"
                        android:scrollbars="vertical"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>