<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fitsSystemWindows="false">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollClientes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ══ HEADER — 172dp cubre status bar + notch ══ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="172dp"
                android:background="@drawable/bg_header_spectacular"
                android:elevation="12dp">

                <View
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/shape_actions_circle_top"
                    android:translationX="50dp"
                    android:translationY="-50dp"/>

                <View
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="bottom|start"
                    android:background="@drawable/shape_actions_circle_bottom"
                    android:translationX="-30dp"
                    android:translationY="30dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="top"
                    android:layout_marginStart="28dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="28dp"
                    android:background="@drawable/shape_shimmer_line"/>

                <!-- paddingTop="56dp" = ~24dp statusBar + 32dp espacio visual -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="56dp"
                    android:paddingBottom="18dp">

                    <FrameLayout
                        android:id="@+id/btnBack"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/shape_inscribir_icon_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="←"
                            android:textSize="20sp"
                            android:textColor="#FFFFFF"
                            android:fontFamily="@font/outfit_bold"
                            android:gravity="center"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KAU NATURE"
                            android:textSize="10sp"
                            android:textColor="#93C5FD"
                            android:fontFamily="@font/outfit_bold"
                            android:letterSpacing="0.24"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clientes"
                            android:textSize="28sp"
                            android:textColor="#FFFFFF"
                            android:fontFamily="@font/outfit_bold"
                            android:shadowColor="#60000000"
                            android:shadowDx="0"
                            android:shadowDy="4"
                            android:shadowRadius="14"
                            android:layout_marginTop="1dp"/>

                        <TextView
                            android:id="@+id/tvClientesSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 registrados"
                            android:textSize="11sp"
                            android:textColor="#BFDBFF"
                            android:fontFamily="@font/outfit_regular"
                            android:layout_marginTop="1dp"
                            android:maxLines="1"
                            android:ellipsize="end"/>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btnAddCliente"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_header_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:elevation="10dp"
                        android:foreground="?attr/selectableItemBackgroundBorderless">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_people"
                            android:tint="@color/accent_blue"/>
                        <TextView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="3dp"
                            android:text="+"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:fontFamily="@font/outfit_bold"
                            android:gravity="center"
                            android:background="@drawable/shape_badge"/>
                    </FrameLayout>

                </LinearLayout>
            </FrameLayout>

            <!-- ══ CONTENIDO ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- BUSCADOR -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_kpi_card"
                    android:clipToOutline="true"
                    android:elevation="6dp"
                    android:outlineProvider="background">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_search"
                            android:tint="#9CA3AF"
                            android:layout_marginEnd="8dp"/>

                        <EditText
                            android:id="@+id/etBuscar"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:hint="Buscar por nombre, teléfono o email…"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="#9CA3AF"
                            android:fontFamily="@font/outfit_regular"
                            android:background="@null"
                            android:inputType="text"
                            android:imeOptions="actionSearch"
                            android:maxLines="1"/>

                        <TextView
                            android:id="@+id/btnLimpiarBusqueda"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="✕"
                            android:textSize="13sp"
                            android:textColor="@color/text_muted"
                            android:gravity="center"
                            android:visibility="gone"
                            android:background="@drawable/shape_chip_blue"/>

                    </LinearLayout>
                </FrameLayout>

                <!-- FILTROS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingBottom="2dp">

                            <TextView
                                android:id="@+id/filtroTodos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Todos"
                                android:textSize="12sp"
                                android:fontFamily="@font/outfit_bold"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/shape_filter_active"
                                android:textColor="@color/white"/>

                            <TextView
                                android:id="@+id/filtroActivos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Activos"
                                android:textSize="12sp"
                                android:fontFamily="@font/outfit_bold"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/shape_filter_inactive"
                                android:textColor="@color/text_muted"/>

                            <TextView
                                android:id="@+id/filtroDeuda"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pendiente"
                                android:textSize="12sp"
                                android:fontFamily="@font/outfit_bold"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/shape_filter_inactive"
                                android:textColor="@color/text_muted"/>

                            <TextView
                                android:id="@+id/filtroInactivos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Inactivos"
                                android:textSize="12sp"
                                android:fontFamily="@font/outfit_bold"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp"
                                android:background="@drawable/shape_filter_inactive"
                                android:textColor="@color/text_muted"/>

                        </LinearLayout>
                    </HorizontalScrollView>

                </LinearLayout>

                <!-- LISTA DE CLIENTES -->
                <LinearLayout
                    android:id="@+id/listaClientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <!-- ESTADO VACÍO -->
                <LinearLayout
                    android:id="@+id/layoutVacioClientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="24dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_kpi_card"
                        android:clipToOutline="true"
                        android:elevation="4dp"
                        android:outlineProvider="background">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="40dp">

                            <ImageView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:src="@drawable/ic_people"
                                android:tint="#D1D5DB"
                                android:layout_gravity="center_horizontal"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sin resultados"
                                android:textSize="18sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="@font/outfit_bold"
                                android:gravity="center"
                                android:layout_marginTop="14dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Prueba con otro filtro o búsqueda"
                                android:textSize="12sp"
                                android:textColor="@color/text_muted"
                                android:fontFamily="@font/outfit_regular"
                                android:gravity="center"
                                android:layout_marginTop="6dp"/>

                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAV FLOTANTE -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_nav_card"
        android:clipToOutline="true"
        android:elevation="24dp"
        android:outlineProvider="background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <LinearLayout android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/nav_item_normal" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="25dp" android:layout_height="25dp" android:elevation="2dp" android:src="@drawable/ic_home" android:tint="#9CA3AF"/>
                <TextView android:id="@+id/navLabelHome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/outfit_bold" android:gravity="center" android:text="Inicio" android:textColor="#9CA3AF" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/nav_clientes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/nav_item_selected" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_people" android:tint="#0A66FF"/>
                <TextView android:id="@+id/navLabelClientes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/outfit_regular" android:gravity="center" android:text="Clientes" android:textColor="#0A66FF" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/nav_gimnasio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/nav_item_normal" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/navIconGimnasio" android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_fitness" android:tint="#9CA3AF"/>
                <TextView android:id="@+id/navLabelGimnasio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/outfit_regular" android:gravity="center" android:text="Gym" android:textColor="#9CA3AF" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/nav_agenda" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/nav_item_normal" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_calendar_today" android:tint="#9CA3AF"/>
                <TextView android:id="@+id/navLabelAgenda" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/outfit_regular" android:gravity="center" android:text="Agenda" android:textColor="#9CA3AF" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/nav_cobros" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/nav_item_normal" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_payments" android:tint="#9CA3AF"/>
                <TextView android:id="@+id/navLabelCobros" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/outfit_regular" android:gravity="center" android:text="Cobros" android:textColor="#9CA3AF" android:textSize="11sp"/>
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>