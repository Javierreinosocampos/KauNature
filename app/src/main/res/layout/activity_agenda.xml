<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fitsSystemWindows="false">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ══ HEADER 172dp cubre notch ══ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="172dp"
                android:background="@drawable/bg_header_spectacular"
                android:elevation="12dp">

                <View android:layout_width="160dp" android:layout_height="160dp" android:layout_gravity="top|end" android:background="@drawable/shape_actions_circle_top" android:translationX="50dp" android:translationY="-50dp"/>
                <View android:layout_width="100dp" android:layout_height="100dp" android:layout_gravity="bottom|start" android:background="@drawable/shape_actions_circle_bottom" android:translationX="-30dp" android:translationY="30dp"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="top" android:layout_marginStart="28dp" android:layout_marginTop="1dp" android:layout_marginEnd="28dp" android:background="@drawable/shape_shimmer_line"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="56dp"
                    android:paddingBottom="18dp">

                    <FrameLayout
                        android:id="@+id/btnBack"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/shape_inscribir_icon_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="←" android:textSize="20sp" android:textColor="#FFFFFF" android:fontFamily="@font/outfit_bold" android:gravity="center"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KAU NATURE" android:textSize="10sp" android:textColor="#93C5FD" android:fontFamily="@font/outfit_bold" android:letterSpacing="0.24"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Agenda" android:textSize="28sp" android:textColor="#FFFFFF" android:fontFamily="@font/outfit_bold" android:shadowColor="#60000000" android:shadowDx="0" android:shadowDy="4" android:shadowRadius="14" android:layout_marginTop="1dp"/>
                        <TextView android:id="@+id/tvAgendaSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hoy" android:textSize="11sp" android:textColor="#BFDBFF" android:fontFamily="@font/outfit_regular" android:layout_marginTop="1dp" android:maxLines="1" android:ellipsize="end"/>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btnAddCita"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_header_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:elevation="10dp"
                        android:foreground="?attr/selectableItemBackgroundBorderless">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_calendar_today" android:tint="@color/accent_blue"/>
                        <TextView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="top|end" android:layout_margin="3dp" android:text="+" android:textSize="11sp" android:textColor="#FFFFFF" android:fontFamily="@font/outfit_bold" android:gravity="center" android:background="@drawable/shape_badge"/>
                    </FrameLayout>

                </LinearLayout>
            </FrameLayout>

            <!-- ── TABS VISTA ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/blue_pale2">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="4dp" android:weightSum="3">
                    <TextView android:id="@+id/tabDiaria" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:text="Diaria" android:textSize="12sp" android:fontFamily="@font/outfit_bold" android:gravity="center" android:background="@drawable/shape_tab_active" android:textColor="@color/white"/>
                    <TextView android:id="@+id/tabSemanal" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:text="Semanal" android:textSize="12sp" android:fontFamily="@font/outfit_bold" android:gravity="center" android:background="@drawable/shape_tab_inactive" android:textColor="@color/text_muted"/>
                    <TextView android:id="@+id/tabMensual" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:text="Mensual" android:textSize="12sp" android:fontFamily="@font/outfit_bold" android:gravity="center" android:background="@drawable/shape_tab_inactive" android:textColor="@color/text_muted"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── CONTENIDO ── -->
            <FrameLayout
                android:id="@+id/contenedorVista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAV FLOTANTE -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_nav_card"
        android:clipToOutline="true"
        android:elevation="24dp"
        android:outlineProvider="background">

        <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:paddingStart="10dp" android:paddingTop="10dp" android:paddingEnd="10dp" android:paddingBottom="10dp">
            <LinearLayout android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/nav_item_normal" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="25dp" android:layout_height="25dp" android:elevation="2dp" android:src="@drawable/ic_home" android:tint="#9CA3AF"/>
                <TextView android:id="@+id/navLabelHome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/outfit_bold" android:gravity="center" android:text="Inicio" android:textColor="#9CA3AF" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/nav_clientes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/nav_item_normal" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_people" android:tint="#9CA3AF"/>
                <TextView android:id="@+id/navLabelClientes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/outfit_regular" android:gravity="center" android:text="Clientes" android:textColor="#9CA3AF" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/nav_gimnasio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/nav_item_normal" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/navIconGimnasio" android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_fitness" android:tint="#9CA3AF"/>
                <TextView android:id="@+id/navLabelGimnasio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/outfit_regular" android:gravity="center" android:text="Gym" android:textColor="#9CA3AF" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/nav_agenda" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/nav_item_selected" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_calendar_today" android:tint="#0A66FF"/>
                <TextView android:id="@+id/navLabelAgenda" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/outfit_regular" android:gravity="center" android:text="Agenda" android:textColor="#0A66FF" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/nav_cobros" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/nav_item_normal" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_payments" android:tint="#9CA3AF"/>
                <TextView android:id="@+id/navLabelCobros" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/outfit_regular" android:gravity="center" android:text="Cobros" android:textColor="#9CA3AF" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>