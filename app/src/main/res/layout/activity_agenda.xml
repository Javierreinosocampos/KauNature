<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── TOPBAR ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/blue_pale"
                    android:layout_marginEnd="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="←"
                        android:textSize="20sp"
                        android:textColor="@color/accent_blue"
                        android:fontFamily="@font/outfit_bold"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agenda"
                        android:textSize="17sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/outfit_bold"/>
                    <TextView
                        android:id="@+id/tvAgendaSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hoy"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:fontFamily="@font/outfit_regular"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>

                <!-- Filtro servicio -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnFiltroServicio"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/blue_pale"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="🔽"
                        android:textSize="16sp"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <!-- Añadir cita -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnAddCita"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/accent_blue">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="＋"
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/outfit_bold"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── TABS VISTA ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/blue_pale2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp"
                android:weightSum="3">

                <TextView
                    android:id="@+id/tabDiaria"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Diaria"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_bold"
                    android:gravity="center"
                    android:background="@drawable/shape_tab_active"
                    android:textColor="@color/white"/>

                <TextView
                    android:id="@+id/tabSemanal"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Semanal"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_bold"
                    android:gravity="center"
                    android:background="@drawable/shape_tab_inactive"
                    android:textColor="@color/text_muted"/>

                <TextView
                    android:id="@+id/tabMensual"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Mensual"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_bold"
                    android:gravity="center"
                    android:background="@drawable/shape_tab_inactive"
                    android:textColor="@color/text_muted"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── CONTENIDO (se reemplaza desde Java) ── -->
        <FrameLayout
            android:id="@+id/contenedorVista"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="60dp"/>

    </LinearLayout>

    <!-- ── BOTTOM NAV (Inicio · Clientes · [COBROS] · Agenda · Ajustes) ── -->
    <!-- ══ BOTTOM NAV: Inicio · Clientes · [💪Gimnasio] · Agenda · Cobros ══ -->
    <LinearLayout
        android:id="@+id/bottomNavCustom"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:elevation="20dp"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <!-- INICIO -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp">
            <TextView
                android:id="@+id/navIconHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="17sp"
                android:gravity="center"/>
            <TextView
                android:id="@+id/navLabelHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textSize="9sp"
                android:textColor="@color/text_muted"
                android:gravity="center"/>
        </LinearLayout>

        <!-- CLIENTES -->
        <LinearLayout
            android:id="@+id/nav_clientes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp">
            <TextView
                android:id="@+id/navIconClientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥"
                android:textSize="17sp"
                android:gravity="center"/>
            <TextView
                android:id="@+id/navLabelClientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clientes"
                android:textSize="9sp"
                android:textColor="@color/text_muted"
                android:gravity="center"/>
        </LinearLayout>
        <!-- GIMNASIO -->
        <LinearLayout
            android:id="@+id/nav_gimnasio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp">
            <TextView
                android:id="@+id/navIconGimnasio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💪"
                android:textSize="17sp"
                android:gravity="center"/>
            <TextView
                android:id="@+id/navLabelGimnasio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gimnasio"
                android:textSize="9sp"
                android:textColor="@color/accent_blue"
                android:gravity="center"/>
        </LinearLayout>

        <!-- AGENDA -->
        <LinearLayout
            android:id="@+id/nav_agenda"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp">
            <TextView
                android:id="@+id/navIconAgenda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅"
                android:textSize="17sp"
                android:gravity="center"/>
            <TextView
                android:id="@+id/navLabelAgenda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agenda"
                android:textSize="9sp"
                android:textColor="@color/text_muted"
                android:gravity="center"/>
        </LinearLayout>

        <!-- COBROS -->
        <LinearLayout
            android:id="@+id/nav_cobros"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp">
            <TextView
                android:id="@+id/navIconCobros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰"
                android:textSize="17sp"
                android:gravity="center"/>
            <TextView
                android:id="@+id/navLabelCobros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cobros"
                android:textSize="9sp"
                android:textColor="@color/text_muted"
                android:gravity="center"/>
        </LinearLayout>

    </LinearLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>